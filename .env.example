# Copy to .env (gitignored), or run ./scripts/setup.sh to generate one with a
# random Grafana password. Docker Compose reads .env automatically.

# ── Grafana ──────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=http://localhost:3000

# ── Network exposure ─────────────────────────
# Host interface the UIs (Grafana, Prometheus, Alertmanager) bind to.
# 127.0.0.1 = this machine only (recommended; put a reverse proxy in front).
# 0.0.0.0   = every interface (only behind a firewall).
BIND_ADDRESS=127.0.0.1

# ── Prometheus ───────────────────────────────
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=10GB
PROMETHEUS_EXTERNAL_URL=http://localhost:9090

# ── Alertmanager ─────────────────────────────
# Notification secrets go in alertmanager/secrets/, not here.
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093
